# Copy to .env and fill the values locally. NEVER upload .env or the bot token to GitHub.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
BRIDGE_PORT=47944
# Delay before hiding a token after Discord reports speech stopped (0–1800 ms).
# Prevents rapid flicker between words. Default: 650.
VOICE_RELEASE_MS=650
